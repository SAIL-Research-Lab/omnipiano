{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://omnipiano.org/schemas/experiment-v2.json",
  "title": "OmniPiano UI Experiment Contract",
  "description": "Canonical frontend-owned experiment request. It is intentionally independent from current track-specific training inputs.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "experiment",
    "task",
    "design",
    "algorithm",
    "protocol",
    "evaluation",
    "compute",
    "tracking"
  ],
  "properties": {
    "schema_version": {
      "const": 2,
      "description": "Version of this canonical UI contract, not a track-specific backend schema."
    },
    "experiment": { "$ref": "#/$defs/experiment" },
    "task": { "$ref": "#/$defs/task" },
    "design": {
      "oneOf": [
        { "$ref": "#/$defs/standardDesign" },
        { "$ref": "#/$defs/robustDesign" },
        { "$ref": "#/$defs/safetyDesign" },
        { "$ref": "#/$defs/marlDesign" }
      ]
    },
    "algorithm": { "$ref": "#/$defs/algorithm" },
    "protocol": { "$ref": "#/$defs/protocol" },
    "evaluation": { "$ref": "#/$defs/evaluation" },
    "compute": { "$ref": "#/$defs/compute" },
    "tracking": { "$ref": "#/$defs/tracking" }
  },
  "$defs": {
    "nullableString": {
      "type": ["string", "null"]
    },
    "keyRange": {
      "type": "array",
      "description": "Inclusive user-facing piano-key interval using 1..88 indexing.",
      "prefixItems": [
        { "type": "integer", "minimum": 1, "maximum": 88 },
        { "type": "integer", "minimum": 1, "maximum": 88 }
      ],
      "minItems": 2,
      "maxItems": 2
    },
    "experiment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "description", "seeds", "tags"],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
        },
        "description": { "type": "string" },
        "seeds": {
          "type": "array",
          "items": { "type": "integer", "minimum": 0 },
          "minItems": 1,
          "uniqueItems": true
        },
        "tags": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        }
      }
    },
    "task": {
      "type": "object",
      "additionalProperties": false,
      "required": ["music", "embodiment", "environment", "reward"],
      "properties": {
        "music": { "$ref": "#/$defs/music" },
        "embodiment": { "$ref": "#/$defs/embodiment" },
        "environment": { "$ref": "#/$defs/environment" },
        "reward": { "$ref": "#/$defs/reward" }
      }
    },
    "music": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source",
        "piece",
        "midi_path",
        "trim_silence",
        "stretch_factor",
        "shift_factor",
        "fingering_mode"
      ],
      "properties": {
        "source": { "enum": ["repertoire", "custom_midi"] },
        "piece": { "$ref": "#/$defs/nullableString" },
        "midi_path": { "$ref": "#/$defs/nullableString" },
        "trim_silence": { "type": "boolean", "default": true },
        "stretch_factor": { "type": "number", "exclusiveMinimum": 0, "default": 1.0 },
        "shift_factor": { "type": "integer", "default": 0 },
        "fingering_mode": { "enum": ["annotated", "optimal_transport"] }
      },
      "allOf": [
        {
          "if": { "properties": { "source": { "const": "repertoire" } } },
          "then": {
            "properties": {
              "piece": { "type": "string", "minLength": 1 },
              "midi_path": { "type": "null" }
            }
          },
          "else": {
            "properties": {
              "piece": { "type": "null" },
              "midi_path": { "type": "string", "minLength": 1 }
            }
          }
        }
      ]
    },
    "hand": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "side", "mobile", "initial_key_range"],
      "properties": {
        "id": { "type": "integer", "minimum": 0, "maximum": 4 },
        "name": { "type": "string", "minLength": 1 },
        "side": { "enum": ["left", "right"] },
        "mobile": { "type": "boolean" },
        "initial_key_range": {
          "oneOf": [
            { "$ref": "#/$defs/keyRange" },
            { "type": "null" }
          ]
        }
      }
    },
    "embodiment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["num_hands", "layout_preset", "mobility", "hands"],
      "properties": {
        "num_hands": { "type": "integer", "minimum": 1, "maximum": 5 },
        "layout_preset": { "type": "string", "minLength": 1 },
        "mobility": { "enum": ["unrestricted", "static_partition", "custom"] },
        "hands": {
          "type": "array",
          "items": { "$ref": "#/$defs/hand" },
          "minItems": 1,
          "maxItems": 5
        }
      }
    },
    "environment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "control_timestep",
        "n_steps_lookahead",
        "gravity_compensation",
        "reduced_action_space",
        "frame_stack",
        "clip_actions",
        "wrong_press_termination",
        "hand_collisions",
        "primitive_fingertip_collisions"
      ],
      "properties": {
        "control_timestep": { "type": "number", "exclusiveMinimum": 0, "default": 0.05 },
        "n_steps_lookahead": { "type": "integer", "minimum": 1, "default": 10 },
        "gravity_compensation": { "type": "boolean", "default": true },
        "reduced_action_space": { "type": "boolean", "default": false },
        "frame_stack": { "type": "integer", "minimum": 1, "default": 1 },
        "clip_actions": { "type": "boolean", "default": true },
        "wrong_press_termination": { "type": "boolean", "default": false },
        "hand_collisions": { "type": "boolean", "default": true },
        "primitive_fingertip_collisions": { "type": "boolean", "default": false }
      }
    },
    "rewardTerm": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled", "coefficient"],
      "properties": {
        "enabled": { "type": "boolean" },
        "coefficient": { "type": "number", "minimum": 0 }
      }
    },
    "reward": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "key_press",
        "sustain",
        "energy_regularization",
        "fingering",
        "forearm_collision"
      ],
      "properties": {
        "key_press": { "$ref": "#/$defs/rewardTerm" },
        "sustain": { "$ref": "#/$defs/rewardTerm" },
        "energy_regularization": { "$ref": "#/$defs/rewardTerm" },
        "fingering": { "$ref": "#/$defs/rewardTerm" },
        "forearm_collision": { "$ref": "#/$defs/rewardTerm" }
      }
    },
    "standardDesign": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "config"],
      "properties": {
        "type": { "const": "standard" },
        "config": {
          "type": "object",
          "additionalProperties": false,
          "required": ["benchmark_variant"],
          "properties": {
            "benchmark_variant": { "enum": ["general", "mobility", "restricted_range"] }
          }
        }
      }
    },
    "robustMagnitude": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "value": { "type": "number" },
        "low": { "type": "number" },
        "high": { "type": "number" },
        "y_mm": { "type": "number", "minimum": 0 },
        "z_mm": { "type": "number", "minimum": 0 }
      },
      "minProperties": 1
    },
    "robustChannel": {
      "type": "object",
      "additionalProperties": false,
      "required": ["target", "distribution", "preset", "frequency", "magnitude"],
      "properties": {
        "target": { "enum": ["action", "observation", "reward", "gravity", "friction", "initial_hand_pose"] },
        "distribution": { "enum": ["gaussian", "bounded_uniform", "constant_shift"] },
        "preset": { "enum": ["low", "medium", "high", "custom"] },
        "frequency": { "enum": ["step", "episode", "run"] },
        "magnitude": { "$ref": "#/$defs/robustMagnitude" }
      }
    },
    "robustDesign": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "config"],
      "properties": {
        "type": { "const": "robust" },
        "config": {
          "type": "object",
          "additionalProperties": false,
          "required": ["channels", "evaluation_modes"],
          "properties": {
            "channels": {
              "type": "array",
              "items": { "$ref": "#/$defs/robustChannel" },
              "minItems": 1,
              "maxItems": 6
            },
            "evaluation_modes": {
              "type": "array",
              "items": { "enum": ["clean", "matched", "cross_severity", "stress"] },
              "minItems": 1,
              "uniqueItems": true
            }
          }
        }
      }
    },
    "safetyCost": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "target_hand_ids",
        "target_joints",
        "safe_interval_fraction",
        "power_threshold",
        "coefficient",
        "budget_mode",
        "episodic_budget"
      ],
      "properties": {
        "type": { "enum": ["range_event", "range_fraction", "range_excess", "power_excess", "power_spike"] },
        "target_hand_ids": {
          "type": "array",
          "items": { "type": "integer", "minimum": 0, "maximum": 4 },
          "minItems": 1,
          "uniqueItems": true
        },
        "target_joints": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        },
        "safe_interval_fraction": { "type": ["number", "null"], "exclusiveMinimum": 0, "maximum": 1 },
        "power_threshold": {
          "description": "Threshold in the backend cost's native power unit; null for range-based costs.",
          "type": ["number", "null"],
          "exclusiveMinimum": 0
        },
        "coefficient": { "type": "number", "minimum": 0 },
        "budget_mode": { "enum": ["paper_default", "custom"] },
        "episodic_budget": { "type": "number", "minimum": 0 }
      }
    },
    "safetyDesign": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "config"],
      "properties": {
        "type": { "const": "safety" },
        "config": {
          "type": "object",
          "additionalProperties": false,
          "required": ["mode", "primary_cost"],
          "properties": {
            "mode": { "const": "single_primary_cost" },
            "primary_cost": { "$ref": "#/$defs/safetyCost" }
          }
        }
      }
    },
    "marlAgent": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "hand_ids",
        "action_key_range",
        "observation_key_range",
        "visible_teammate_hands"
      ],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "hand_ids": {
          "type": "array",
          "items": { "type": "integer", "minimum": 0, "maximum": 4 },
          "minItems": 1,
          "uniqueItems": true
        },
        "action_key_range": { "$ref": "#/$defs/keyRange" },
        "observation_key_range": { "$ref": "#/$defs/keyRange" },
        "visible_teammate_hands": {
          "oneOf": [
            { "enum": ["none", "boundary", "all"] },
            {
              "type": "array",
              "items": { "type": "integer", "minimum": 0, "maximum": 4 },
              "uniqueItems": true
            }
          ]
        }
      }
    },
    "marlDesign": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "config"],
      "properties": {
        "type": { "const": "marl" },
        "config": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "num_agents",
            "assignment",
            "sustain_owner",
            "shared_reward",
            "policy_sharing",
            "critic_mode",
            "agents",
            "coordination"
          ],
          "properties": {
            "num_agents": { "type": "integer", "minimum": 1, "maximum": 5 },
            "assignment": { "enum": ["balanced", "contiguous", "explicit"] },
            "sustain_owner": { "type": "string", "minLength": 1 },
            "shared_reward": { "type": "boolean" },
            "policy_sharing": { "enum": ["independent", "shared"] },
            "critic_mode": { "enum": ["local", "centralized", "own_observation_ablation"] },
            "agents": {
              "type": "array",
              "items": { "$ref": "#/$defs/marlAgent" },
              "minItems": 1,
              "maxItems": 5
            },
            "coordination": {
              "type": "object",
              "additionalProperties": false,
              "required": ["inter_agent_collision_penalty_coefficient", "log_duplicate_press", "log_inter_agent_collision"],
              "properties": {
                "inter_agent_collision_penalty_coefficient": { "type": "number", "minimum": 0 },
                "log_duplicate_press": { "type": "boolean" },
                "log_inter_agent_collision": { "type": "boolean" }
              }
            }
          }
        }
      }
    },
    "parameterValue": {
      "anyOf": [
        { "type": "number" },
        { "type": "integer" },
        { "type": "boolean" },
        { "type": "string" },
        { "type": "null" },
        {
          "type": "array",
          "items": { "type": ["number", "integer", "boolean", "string", "null"] }
        }
      ]
    },
    "algorithm": {
      "type": "object",
      "additionalProperties": false,
      "required": ["framework", "name", "family", "preset", "parameters"],
      "properties": {
        "framework": { "enum": ["rllib", "stable_baselines3", "torchrl", "omnisafe", "custom"] },
        "name": { "type": "string", "minLength": 1 },
        "family": { "enum": ["ppo", "sac", "safe_policy_optimization", "value_decomposition", "transformer", "custom"] },
        "preset": { "enum": ["paper_default", "omnipiano_default", "smoke_test", "custom"] },
        "parameters": {
          "type": "object",
          "additionalProperties": { "$ref": "#/$defs/parameterValue" }
        }
      }
    },
    "protocol": {
      "type": "object",
      "additionalProperties": false,
      "required": ["total_env_steps", "gamma", "checkpoint_frequency", "keep_best_checkpoint"],
      "properties": {
        "total_env_steps": { "type": "integer", "minimum": 1 },
        "gamma": { "type": "number", "minimum": 0, "maximum": 1 },
        "checkpoint_frequency": { "type": "integer", "minimum": 0 },
        "keep_best_checkpoint": { "type": "boolean" }
      }
    },
    "video": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled", "frequency", "record_final", "camera_id", "height", "width"],
      "properties": {
        "enabled": { "type": "boolean" },
        "frequency": { "type": "integer", "minimum": 0 },
        "record_final": { "type": "boolean" },
        "camera_id": { "type": "string", "minLength": 1 },
        "height": { "type": "integer", "minimum": 1 },
        "width": { "type": "integer", "minimum": 1 }
      }
    },
    "evaluation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["frequency", "episodes", "seed_offset", "video"],
      "properties": {
        "frequency": { "type": "integer", "minimum": 1 },
        "episodes": { "type": "integer", "minimum": 1 },
        "seed_offset": { "type": "integer", "minimum": 0 },
        "video": { "$ref": "#/$defs/video" }
      }
    },
    "compute": {
      "type": "object",
      "additionalProperties": false,
      "required": ["env_runners", "learners", "cpus_per_env_runner", "gpus_per_learner"],
      "properties": {
        "env_runners": { "type": "integer", "minimum": 0 },
        "learners": { "type": "integer", "minimum": 0 },
        "cpus_per_env_runner": { "type": "number", "minimum": 0 },
        "gpus_per_learner": { "type": "number", "minimum": 0 }
      }
    },
    "tracking": {
      "type": "object",
      "additionalProperties": false,
      "required": ["provider", "mode", "entity", "project", "group", "run_name", "upload_artifacts"],
      "properties": {
        "provider": { "enum": ["none", "wandb"] },
        "mode": { "enum": ["disabled", "offline", "online"] },
        "entity": { "$ref": "#/$defs/nullableString" },
        "project": { "$ref": "#/$defs/nullableString" },
        "group": { "$ref": "#/$defs/nullableString" },
        "run_name": { "$ref": "#/$defs/nullableString" },
        "upload_artifacts": { "type": "boolean" }
      }
    }
  }
}
