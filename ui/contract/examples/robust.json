{
  "schema_version": 2,
  "experiment": {
    "name": "robust_clair_de_lune_action_obs_medium",
    "description": "Composable medium action and observation perturbations.",
    "seeds": [0, 1, 2],
    "tags": ["robust", "action-noise", "observation-noise"]
  },
  "task": {
    "music": {
      "source": "repertoire",
      "piece": "ClairDeLune",
      "midi_path": null,
      "trim_silence": true,
      "stretch_factor": 1.0,
      "shift_factor": 0,
      "fingering_mode": "optimal_transport"
    },
    "embodiment": {
      "num_hands": 2,
      "layout_preset": "two_hand_default",
      "mobility": "unrestricted",
      "hands": [
        {
          "id": 0,
          "name": "left_hand",
          "side": "left",
          "mobile": true,
          "initial_key_range": [1, 44]
        },
        {
          "id": 1,
          "name": "right_hand",
          "side": "right",
          "mobile": true,
          "initial_key_range": [45, 88]
        }
      ]
    },
    "environment": {
      "control_timestep": 0.05,
      "n_steps_lookahead": 10,
      "gravity_compensation": true,
      "reduced_action_space": false,
      "frame_stack": 1,
      "clip_actions": true,
      "wrong_press_termination": false,
      "hand_collisions": true,
      "primitive_fingertip_collisions": false
    },
    "reward": {
      "key_press": { "enabled": true, "coefficient": 1.0 },
      "sustain": { "enabled": true, "coefficient": 1.0 },
      "energy_regularization": { "enabled": true, "coefficient": 0.005 },
      "fingering": { "enabled": true, "coefficient": 1.0 },
      "forearm_collision": { "enabled": true, "coefficient": 1.0 }
    }
  },
  "design": {
    "type": "robust",
    "config": {
      "channels": [
        {
          "target": "action",
          "distribution": "gaussian",
          "preset": "medium",
          "frequency": "step",
          "magnitude": { "value": 0.1 }
        },
        {
          "target": "observation",
          "distribution": "gaussian",
          "preset": "medium",
          "frequency": "step",
          "magnitude": { "value": 0.1 }
        }
      ],
      "evaluation_modes": ["clean", "matched", "cross_severity"]
    }
  },
  "algorithm": {
    "framework": "stable_baselines3",
    "name": "sac",
    "family": "sac",
    "preset": "omnipiano_default",
    "parameters": {
      "learning_rate": 0.0003,
      "batch_size": 256,
      "buffer_size": 1000000,
      "learning_starts": 10000,
      "hidden_sizes": [256, 256]
    }
  },
  "protocol": {
    "total_env_steps": 5000000,
    "gamma": 0.8,
    "checkpoint_frequency": 500000,
    "keep_best_checkpoint": true
  },
  "evaluation": {
    "frequency": 50000,
    "episodes": 1,
    "seed_offset": 10000,
    "video": {
      "enabled": true,
      "frequency": 500000,
      "record_final": true,
      "camera_id": "piano/topdown",
      "height": 480,
      "width": 640
    }
  },
  "compute": {
    "env_runners": 4,
    "learners": 1,
    "cpus_per_env_runner": 1,
    "gpus_per_learner": 1.0
  },
  "tracking": {
    "provider": "wandb",
    "mode": "online",
    "entity": "omnipiano",
    "project": "robust",
    "group": null,
    "run_name": null,
    "upload_artifacts": false
  }
}
