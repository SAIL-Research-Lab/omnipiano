{
  "schema_version": 2,
  "experiment": {
    "name": "marl_winterwind_4h_2a_mappo",
    "description": "Four-hand two-agent MAPPO experiment.",
    "seeds": [0, 1, 2],
    "tags": ["marl", "four-hand", "mappo"]
  },
  "task": {
    "music": {
      "source": "repertoire",
      "piece": "WinterWind",
      "midi_path": null,
      "trim_silence": true,
      "stretch_factor": 1.0,
      "shift_factor": 0,
      "fingering_mode": "optimal_transport"
    },
    "embodiment": {
      "num_hands": 4,
      "layout_preset": "FourHand",
      "mobility": "custom",
      "hands": [
        {
          "id": 0,
          "name": "lh_b",
          "side": "left",
          "mobile": true,
          "initial_key_range": [1, 22]
        },
        {
          "id": 1,
          "name": "rh_b",
          "side": "right",
          "mobile": true,
          "initial_key_range": [23, 44]
        },
        {
          "id": 2,
          "name": "lh_t",
          "side": "left",
          "mobile": true,
          "initial_key_range": [45, 66]
        },
        {
          "id": 3,
          "name": "rh_t",
          "side": "right",
          "mobile": true,
          "initial_key_range": [67, 88]
        }
      ]
    },
    "environment": {
      "control_timestep": 0.05,
      "n_steps_lookahead": 10,
      "gravity_compensation": true,
      "reduced_action_space": false,
      "frame_stack": 1,
      "clip_actions": true,
      "wrong_press_termination": false,
      "hand_collisions": true,
      "primitive_fingertip_collisions": false
    },
    "reward": {
      "key_press": { "enabled": true, "coefficient": 1.0 },
      "sustain": { "enabled": true, "coefficient": 1.0 },
      "energy_regularization": { "enabled": true, "coefficient": 0.005 },
      "fingering": { "enabled": true, "coefficient": 1.0 },
      "forearm_collision": { "enabled": true, "coefficient": 1.0 }
    }
  },
  "design": {
    "type": "marl",
    "config": {
      "num_agents": 2,
      "assignment": "explicit",
      "sustain_owner": "agent_1",
      "shared_reward": true,
      "policy_sharing": "independent",
      "critic_mode": "centralized",
      "agents": [
        {
          "name": "agent_1",
          "hand_ids": [0, 1],
          "action_key_range": [1, 52],
          "observation_key_range": [1, 60],
          "visible_teammate_hands": [2]
        },
        {
          "name": "agent_2",
          "hand_ids": [2, 3],
          "action_key_range": [37, 88],
          "observation_key_range": [29, 88],
          "visible_teammate_hands": [1]
        }
      ],
      "coordination": {
        "inter_agent_collision_penalty_coefficient": 0.1,
        "log_duplicate_press": true,
        "log_inter_agent_collision": true
      }
    }
  },
  "algorithm": {
    "framework": "rllib",
    "name": "mappo",
    "family": "ppo",
    "preset": "omnipiano_default",
    "parameters": {
      "learning_rate": 0.0003,
      "critic_learning_rate": 0.0003,
      "train_batch_size": 4000,
      "minibatch_size": 4000,
      "num_epochs": 5,
      "adam_epsilon": 0.00001,
      "gae_lambda": 0.95,
      "clip_param": 0.2,
      "value_clip_param": 0.2,
      "entropy_coefficient": 0.0,
      "use_kl_loss": false,
      "gradient_clip": 10.0,
      "hidden_sizes": [256, 256],
      "input_layer_norm": true,
      "value_norm": true
    }
  },
  "protocol": {
    "total_env_steps": 10000000,
    "gamma": 0.8,
    "checkpoint_frequency": 500000,
    "keep_best_checkpoint": true
  },
  "evaluation": {
    "frequency": 50000,
    "episodes": 1,
    "seed_offset": 10000,
    "video": {
      "enabled": true,
      "frequency": 500000,
      "record_final": true,
      "camera_id": "piano/topdown",
      "height": 480,
      "width": 640
    }
  },
  "compute": {
    "env_runners": 9,
    "learners": 1,
    "cpus_per_env_runner": 1,
    "gpus_per_learner": 1.0
  },
  "tracking": {
    "provider": "wandb",
    "mode": "online",
    "entity": "omnipiano",
    "project": "multiagent",
    "group": null,
    "run_name": null,
    "upload_artifacts": false
  }
}
